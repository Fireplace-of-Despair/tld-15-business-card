@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using tld15Server.Frontend.Components.Common.LocalTime
@using tld15Server.Frontend.Components.Icons
@using tld15Server.Frontend.Components.Navigations
@using tld15Server.Composition
@using tld15Server.Frontend.Navigations
@inject NavigationState NavState

@* Only the pages behind the login show a time in the reader's own zone, and this is the component
   that opens a circuit to ask the browser for it. A visitor pays for neither. *@
<AuthorizeView>
    <Authorized>
        <InitializeBrowserTime @rendermode="InteractiveServer" />
    </Authorized>
</AuthorizeView>

<header>
    <a class="brand-header-name" href="@Pages.Home.Url">
        @Localizer["Brand"]
    </a>
    <div class="brand-header-slogan">
        <i>@Localizer["Brand.Slogan"]</i>
    </div>

    @* The pages a visitor moves between. The section that manages the site keeps its own navigation
       at the side, and two rows of links pointing at different worlds only confuse the one reading. *@
    @if (!IsAdmin)
    {
        <GlobalNavigation />
    }
</header>

<div class="page">
    <CascadingValue Value="NavState">
    <AuthorizeView>
        <Authorized>
            <Navigation @rendermode="InteractiveServer" />
        </Authorized>
    </AuthorizeView>

    <main>
        <article>
            @Body
        </article>
    </main>
    </CascadingValue>
</div>

<footer>
    <AuthorizeView>
        <Authorized>
            <a class="icon-button logo"
               href="@Pages.Identity.LogoutPage.Url"
               aria-label="@Localizer["Identity.DoLogout"]">
                <Logout />
            </a>
        </Authorized>
        <NotAuthorized>
            <a class="icon-button logo"
               href="@Pages.Identity.LoginPage.Url"
               aria-label="@Localizer["Identity.DoLogin"]"><Login /></a>
        </NotAuthorized>
    </AuthorizeView>

    <a class="icon-button logo"
       href="@Pages.Settings.ChangeLanguagePage.Url"
       aria-label="@Localizer["Navigation.ChangeLanguage"]">
        <Translate />
    </a>
    <div class="copyright">
        @DateTimeOffset.UtcNow.Year © @Localizer["Brand.Company"]
    </div>
    @* The MPL asks for no source from a hosted build. A remote user still cannot read the code
       that runs, so the footer offers the address of it. *@
    <div class="source">
        <a href="@SourceUrl" rel="noopener noreferrer" target="_blank" title="@Globals.License.Spdx">
            @Localizer["Common.SourceCode"]
        </a>
    </div>
</footer>
