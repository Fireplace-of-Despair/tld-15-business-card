@using Microsoft.AspNetCore.Components.Authorization
@using tld15Server.Composition

@if (!_hasFeature) { return; }

@ChildContent

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    [Parameter] public string? Feature { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _hasFeature { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrEmpty(Feature))
        {
            _hasFeature = true; // Show content if no feature is specified
            return;
        }

        var authState = await AuthenticationState;
        var user = authState.User;

        _hasFeature = user.Claims.Any(c =>
               c.Type == Globals.CustomClaim.Feature
            && c.Value == Feature);
    }
}
