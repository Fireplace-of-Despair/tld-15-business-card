@using System.Globalization
@using tld15Server.Composition
@using tld15Server.Features.Shared.Business
<div id="@SharedCardContent.Id" class="article-card">
    <div class="article-image-container">

        <NavLink href="@_url" rel="canonical">
            @if (string.IsNullOrEmpty(SharedCardContent.PosterUrl))
            {
                <img class="article-image" loading="lazy"
                     src="/images/placeholder/SharedCardContent.png"
                     alt="@SharedCardContent.PosterAlt"
                     aria-labelledby="@SharedCardContent.PosterAlt">
            }
            else
            {
                <img class="article-image" loading="lazy"
                     src="@SharedCardContent.PosterUrl"
                     alt="@SharedCardContent.PosterAlt"
                     aria-labelledby="@SharedCardContent.PosterAlt">
            }
        </NavLink>
        <div class="article-image-overlay-division"
             data-tooltip="@SharedCardContent.DivisionName">
            @SharedCardContent.DivisionId.ToUpper()
        </div>

        <div class="article-image-overlay-date">
            @SharedCardContent.CreatedAt.ToString(Globals.Settings.DateFormat, CultureInfo.InvariantCulture)
        </div>
    </div>

    <NavLink href="@_url"
        rel="canonical"
        class="article-title">
        <b>@SharedCardContent.Title</b>
    </NavLink>

    <div class="article-description">
        @SharedCardContent.Subtitle
    </div>

    <div class="project-buttons-container">
        @if (SharedCardContent.ProjectTypeId == Globals.ProjectType.Project)
        {
            var links = SharedCardContent.LinksToDictionary();

            @foreach (var link in links)
            {
                <a class="external-button" href="@link.Value">
                    <div class="external-button-language">
                        @if (!string.IsNullOrEmpty(IconHelper.GetLanguage(@link.Key)))
                        {
                            @IconHelper.GetLanguage(@link.Key)
                        }
                    </div>
                    <img class="external-button-icon" loading="lazy"
                         src="@IconHelper.GetIcon(@link.Key)"
                         alt="@link.Key">
                </a>
            }
    }
    </div>

</div>
