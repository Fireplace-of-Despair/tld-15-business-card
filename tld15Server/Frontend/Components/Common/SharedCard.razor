@using System.Globalization
@using tld15Server.Common
@using tld15Server.Composition
@using tld15Server.Features.Shared.Business
<div id="@SharedCardContent.Id" class="article-card">
    <div class="article-image-container">

        @* A card that leads off the site opens where it leads and hands that page nothing. *@
        <a href="@_url" target="@(_external ? "_blank" : null)" rel="@(_external ? "noopener noreferrer" : null)">
            @if (string.IsNullOrEmpty(SharedCardContent.PosterUrl))
            {
                <img class="article-image" loading="lazy"
                     src="/images/placeholder/project.png"
                     alt="@SharedCardContent.PosterAlt">
            }
            else
            {
                <img class="article-image" loading="lazy"
                     src="@SharedCardContent.PosterUrl"
                     alt="@SharedCardContent.PosterAlt">
            }
        </a>
        @if (!string.IsNullOrEmpty(SharedCardContent.DivisionId))
        {
            <div class="article-image-overlay-division tooltip"
                 data-tooltip="@SharedCardContent.DivisionName">
                @SharedCardContent.DivisionId.ToUpper()
            </div>
        }

        <div class="article-image-overlay-date">
            <time datetime="@SharedCardContent.PublishedAt.UtcDateTime.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">
                @SharedCardContent.PublishedAt.ToString(Globals.Settings.DateFormat, CultureInfo.InvariantCulture)
            </time>
        </div>
    </div>

    <a href="@_url"
       class="article-title"
       target="@(_external ? "_blank" : null)"
       rel="@(_external ? "noopener noreferrer" : null)">
        <b>@SharedCardContent.Title</b>
    </a>

    <div class="article-description">
        @SharedCardContent.Subtitle
    </div>

    <div class="project-buttons-container">
        @if (SharedCardContent.ProjectTypeId == Globals.ProjectType.Project)
        {
            var links = SharedCardContent.LinksToDictionary();

            @foreach (var link in links)
            {
                @* The stored key holds the icon and the language, but the icon now follows from the
                   address itself, so only the language of the key is still worth reading. *@
                var (_, language) = SharedLink.SplitKey(link.Key);

                <ExternalLinkIcon Url="@link.Value" Language="@language" />
            }
    }
    </div>

</div>
