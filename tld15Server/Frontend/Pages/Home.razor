@using tld15Server.Frontend.Components.Common
@attribute [Route(Home.Url)]
@rendermode InteractiveServer
@inherits BasePage

<PageTitle> @Localizer["Brand"] | @Localizer["Brand.Slogan"] </PageTitle>

@if (Lore != null && !string.IsNullOrEmpty(Lore.Html))
{
    <div class="component-container-column">
        <style>
                .lore-content {
                    max-width: 1000px;
                    display: flex;
                    flex-wrap: wrap-reverse;
                    justify-content: flex-start;
                }

                .lore-content-text {
                    flex: 1;
                    min-width: 60%;
                    padding-left: 20px;
                    padding-right: 20px;
                    box-sizing: border-box;
                }

                .lore-content-image {
                    flex: 1 0 0;
                    padding: 20px;
                    padding-left: 20px;
                    padding-right: 20px;
                    box-sizing: border-box;
                }

                    .lore-content-image img {
                        width: 100%;
                        height: 600px;
                        object-fit: cover;
                        filter: grayscale(100%) contrast(130%);
                        transition: all 0.8s ease 0s;
                    }

                        .lore-content-image img:hover {
                            filter: grayscale(0) contrast(100%);
                        }

                @@media (max-width: 768px) {
                    .lore-content-image {
                        flex-direction: column;
                    }

                    .lore-content-text {
                        min-width: 100%;
                        text-align: left;
                    }

                    .lore-content-image {
                        min-width: 100%;
                    }

                        .lore-content-image img {
                            height: auto;
                        }
                }
        </style>

        <h2 id="@Lore.Id" class="component-title">@Lore.Title</h2>
        @((MarkupString)Lore.Html)
</div>
}

@if (Articles.Any())
{
    <div class="component-container-column">
        <h2 id="articles" class="component-title">@Localizer["Articles"]</h2>

        <div class="articles-container">
            @foreach (var article in Articles)
            {
                <SharedCard SharedCardContent="article" />
            }
        </div>
    </div>
}

@if (Projects.Any())
{
    <div class="component-container-column">
        <h2 id="projects" class="component-title">@Localizer["Projects"]</h2>
        <div class="articles-container">
            @foreach (var project in Projects)
            {
                <SharedCard SharedCardContent="project" />
            }
        </div>
    </div>
}

@if (Social != null && !string.IsNullOrEmpty(Social.Json))
{
    <div class="component-container-column">
        <h2 id="@Social.Id" class="component-title">@Social.Title</h2>
        <div class="social-container">
            @foreach (var link in @Social.JsonToDictionary())
            {
                <a href="@link.Value">
                    <img class="social-button"
                         src="@IconHelper.GetIcon(link.Key)"
                         alt="@link.Key"
                         aria-labelledby="@link.Key">
                </a>
            }
        </div>
    </div>
}

@if (Contacts != null && !string.IsNullOrEmpty(Contacts.Json))
{
    <div class="component-container-column">
        <h2 id="@Contacts.Id" class="component-title">@Contacts.Title</h2>
        <div class="social-container">
            @foreach (var link in @Contacts.JsonToDictionary())
            {
                <a href="@link.Value">
                    <img class="social-button"
                         src="@IconHelper.GetIcon(link.Key)"
                         alt="@link.Key"
                         aria-labelledby="@link.Key">
                </a>
            }
        </div>
    </div>
}
