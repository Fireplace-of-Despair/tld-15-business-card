@attribute [Route($"{ContentTextEditPage.Url}/{ContentTextEditPage.UrlParamId}")]
@inherits BasePage
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using tld15Server.Frontend.Components.Common

<PageTitle>
    @Localizer["Brand"] | @Localizer["Common.Update"] @Localizer["Content"]
</PageTitle>

<div class="component-container-column">
    <h1>@(_content == null ? Localizer["Content"].Value : _content.Title)</h1>
</div>

@if (IsLoading)
{
    <div class="component-container-column">
        <Spinner />
    </div>
    return;
}

@if (IncidentCode != null)
{
    <div class="component-container-column">
        <FriendlyIncident Code="@IncidentCode" />
    </div>
}

@if (_content == null)
{
    return;
}

<div class="component-container-column">
    <LanguageTabs Languages="@_content.Languages" @bind-Selected="_language" HasContent="HasText" />

    <MarkdownEditor @bind-Value="Text" />
</div>

<VersionInfo UpdatableModel="@_content" VersionLocalModel="@_content" />

<div class="component-container-row">
    <AuthorizeView Policy="@Features.Contents.ContentPostFeature.Id">
        <Authorized>
            <button @onclick="() => Save()">@Localizer["Common.Save"]</button>
        </Authorized>
    </AuthorizeView>
</div>
