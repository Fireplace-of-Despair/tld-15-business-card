@attribute [Route($"{ContentTextEditPage.Url}/{ContentTextEditPage.UrlParamId}")]
@inherits BasePage
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using tld15Server.Frontend.Components.Common

<PageTitle>
    @Localizer["Brand"] | @Localizer["Common.Update"] @Localizer["Content"]
</PageTitle>

<div class="component-container-column">
    <h1>@(_content == null ? Localizer["Content"].Value : _content.Title)</h1>
</div>

@if (IsLoading)
{
    <div class="component-container-column">
        <Spinner />
    </div>
    return;
}

@if (IncidentCode != null)
{
    <div class="component-container-column">
        <FriendlyIncident Code="@IncidentCode" />
    </div>
}

@if (_content == null)
{
    return;
}

<div class="component-container-column">
    <div class="component-container-row">
        <div class="input-group poster-group">
            <label for="content-poster">@Localizer["Common.Poster.Url"]</label>
            <input id="content-poster"
                   type="url"
                   class="poster-url @(IsPosterValid ? string.Empty : "invalid")"
                   @bind="_posterUrl"
                   @bind:event="oninput" />
            @if (!IsPosterValid)
            {
                <span class="field-error">@Localizer["Common.Validation.Poster"]</span>
            }
        </div>

        @if (IsPosterValid && !string.IsNullOrWhiteSpace(_posterUrl))
        {
            <div class="poster-preview">
                <img src="@_posterUrl" alt="@PosterAlt" loading="lazy" />
            </div>
        }
    </div>
</div>

<div class="component-container-column">
    <LanguageTabs Languages="@_content.Languages" @bind-Selected="_language" HasContent="HasText" />

    <div class="component-container-row">
        <div class="input-group poster-group">
            <label for="content-poster-alt">@Localizer["Common.Poster.Alt"]</label>
            <input id="content-poster-alt" class="poster-url" type="text" @bind="PosterAlt" />
        </div>
    </div>

    <MarkdownEditor @bind-Value="Text" />
</div>

<VersionInfo UpdatableModel="@_content" VersionLocalModel="@_content" />

<div class="component-container-row">
    <AuthorizeView Policy="@Features.Contents.ContentPostFeature.Id">
        <Authorized>
            <button disabled="@(!CanSave)" @onclick="() => Save()">@Localizer["Common.Save"]</button>
        </Authorized>
    </AuthorizeView>
</div>
