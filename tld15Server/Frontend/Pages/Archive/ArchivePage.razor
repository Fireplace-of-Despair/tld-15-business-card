@attribute [Route(ArchivePage.Url)]
@inherits BasePage
@using tld15Server.Composition
@using tld15Server.Frontend.Components.Common

@* No render mode. The page is a wall of links and nothing on it is operated. *@

<PageTitle>@Localizer["Brand"] | @Localizer["Archive"]</PageTitle>

<HeadContent>
    <meta name="description" content="@_description" />
    <link rel="canonical" href="@_canonical" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="@Localizer["Brand"]" />
    <meta property="og:title" content="@Localizer["Brand"] | @Localizer["Archive"]" />
    <meta property="og:description" content="@_description" />
    <meta property="og:url" content="@_canonical" />
    <meta property="og:locale" content="@Language" />
    @* A wall of cards carries no work of its own to show, so the card of this page is the mark of
       the site. Without one a shared link renders as a grey box with a line of text in it. *@
    <meta property="og:image" content="@_shareCard" />
</HeadContent>

@if (IncidentCode != null)
{
    <div class="component-container-column-narrow">
        <FriendlyIncident Code="@IncidentCode" />
    </div>
    return;
}

<div class="component-container-column-narrow">
    <h1 id="archive" class="component-title">@Localizer["Archive"]</h1>
</div>


@if (Articles.Count == 0 && Projects.Count == 0)
{
    <div class="component-container-column-narrow">
        <div>@Localizer["Common.NothingWasFound"]</div>
    </div>
    return;
}

@if (Articles.Count > 0)
{
    <div class="component-container-column-narrow">
        <h2 id="@Globals.Anchor.Articles" class="component-title">@Localizer["Articles"]</h2>

        <div class="cards-container">
            @foreach (var article in Articles)
            {
                <SharedCard SharedCardContent="article" />
            }
        </div>
    </div>
}

@if (Projects.Count > 0)
{
    <div class="component-container-column-narrow">
        <h2 id="@Globals.Anchor.Projects" class="component-title">@Localizer["Projects"]</h2>

        <div class="cards-container">
            @foreach (var project in Projects)
            {
                <SharedCard SharedCardContent="project" />
            }
        </div>
    </div>
}
