{
    "Serilog": {
        "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
        "MinimumLevel": "Debug",
        "WriteTo": [
            { "Name": "Console" }
        ],
        "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
        "Properties": {
            "Application": "tld15"
        }
    },
    "Automation": {
        "TimeoutMinutes": 60
    },
    "ConnectionStrings": {
        "PostgreSQL": "Server=localhost;Port=5432;Database=tld15-local;UserId=postgres;Password=sa;Pooling=true;Include Error Detail=True"
    },
    "Application": {
        "Host": "http://localhost:5105",
        "SourceUrl": "https://github.com/Fireplace-of-Despair/tld-15-business-card",
        "TwitterAccount": "stainless_chief"
    },
    "ShutdownTimeoutSeconds": 2,
    "Security": {
        "Pepper": "qwerty",
        "SaltSize": 128,
        "CookieExpiration": 480,
        "CookieMaxAge": 1440,
        "LoginMaxAttempts": 5,
        "LoginMaxAttemptsPerAddress": 25,
        "LoginLockoutMinutes": 15,
        "ForwardedHeaders": {
            "KnownProxies": [],
            "KnownNetworks": [],
            "ForwardLimit": 1
        },
        "RateLimit": {
            "WindowSeconds": 60,
            "GlobalPermits": 1000,
            "ApiPermits": 100
        }
    },
    "AllowedHosts": "*"
}
