{
    "Serilog": {
        "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
        "MinimumLevel": "Debug",
        "WriteTo": [
            { "Name": "Console" }
        ],
        "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
        "Properties": {
            "Application": "tld15"
        }
    },
    "Automation": {
        "TimeoutMinutes": 60
    },
    "ConnectionStrings": {
        "PostgreSQL": "Server=localhost;Port=5432;Database=tld15-local-test;UserId=postgres;Password=sa;Pooling=true;Include Error Detail=True"
    },
    "Application": {
        "Host": "http://localhost:5190"
    },
    "Security": {
        "Pepper": "qwerty",
        "SaltSize": 32,
        "CookieExpiration": 480,
        "CookieMaxAge": 1440,
        "LoginMaxAttempts": 5,
        "LoginMaxAttemptsPerAddress": 25,
        "LoginLockoutMinutes": 15
    },
    "AllowedHosts": "*"
}
