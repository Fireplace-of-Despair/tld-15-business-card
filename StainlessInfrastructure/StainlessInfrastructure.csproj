<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <NeutralLanguage>en</NeutralLanguage>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup Label="Analysis">
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-minimum</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="Brand">
    <Product>tld15</Product>
    <Authors>Stan "Chief" Shevtsov</Authors>
    <Company>Fireplace Of Despair</Company>
    <Copyright>Fireplace Of Despair</Copyright>
    <Version>1.0.0</Version>
    <PackageProjectUrl>https://github.com/Fireplace-of-Despair/tld-15-business-card</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentMigrator.Runner.Postgres" Version="8.0.1" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StainlessCore\StainlessCore.csproj" />
  </ItemGroup>

  <!-- Reference data that the seed migrations read at startup. -->
  <ItemGroup>
    <Content Include=".import\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
