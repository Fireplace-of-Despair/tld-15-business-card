{
    "Serilog": {
        "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft.AspNetCore": "Warning",
                "Microsoft.EntityFrameworkCore": "Warning"
            }
        },
        "WriteTo": [
            { "Name": "Console" },
            {
                "Name": "File",
                "Args": {
                    "path": "/app/logs/tld15-.log",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 30,
                    "shared": true
                }
            }
        ],
        "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
        "Properties": {
            "Application": "tld15"
        }
    },
    "Automation": {
        "TimeoutMinutes": 60
    },
    "ConnectionStrings": {
        "PostgreSQL": "Server=host.docker.internal;Port=5432;Database=tld15;UserId=tld15;Password=CHANGE_ME;Pooling=true"
    },
    "Application": {
        "Host": "https://example.com",
        "SourceUrl": "https://github.com/Fireplace-of-Despair/tld-15-business-card"
    },
    "Security": {
        "Pepper": "CHANGE_ME_LONG_RANDOM_STRING",
        "SaltSize": 128,
        "CookieExpiration": 480,
        "CookieMaxAge": 1440,
        "LoginMaxAttempts": 5,
        "LoginMaxAttemptsPerAddress": 25,
        "LoginLockoutMinutes": 15,
        "ForwardedHeaders": {
            "KnownProxies": [],
            "KnownNetworks": [ "172.28.0.0/16" ],
            "ForwardLimit": 1
        },
        "RateLimit": {
            "WindowSeconds": 60,
            "GlobalPermits": 300,
            "ApiPermits": 30
        }
    },
    "AllowedHosts": "example.com"
}
